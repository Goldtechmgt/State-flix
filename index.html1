<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stateflix Agency - Digital Earning Platform</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .glow-hover:hover {
            box-shadow: 0 0 15px rgba(59, 130, 246, 0.5);
            transform: translateY(-2px);
            transition: all 0.3s ease;
        }
    </style>
</head>
<body class="bg-[#0f172a] text-slate-200 font-sans selection:bg-blue-500 selection:text-white">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 bg-[#1e293b]/90 backdrop-blur-md border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center shadow-lg shadow-blue-500/20">
                    <span class="text-white font-black text-xl tracking-wider">S</span>
                </div>
                <span class="font-extrabold text-xl bg-gradient-to-r from-white via-slate-200 to-blue-400 bg-clip-text text-transparent tracking-tight">STATEFLIX <span class="text-blue-500 text-sm font-semibold tracking-normal">AGENCY</span></span>
            </div>
            <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-400">
                <a href="#earning-hub" class="hover:text-white transition-colors">Earning Hub</a>
                <a href="#how-it-works" class="hover:text-white transition-colors">How It Works</a>
                <a href="#features" class="hover:text-white transition-colors">Features</a>
            </nav>
            <div class="flex items-center gap-4">
                <a href="#login" class="text-sm font-semibold text-slate-300 hover:text-white transition-colors px-4 py-2">Sign In</a>
                <a href="#register" class="bg-blue-600 hover:bg-blue-500 text-white text-sm font-bold px-5 py-2.5 rounded-xl transition-all shadow-lg shadow-blue-600/20 active:scale-95">Get Started</a>
            </div>
        </div>
    </header>

    <main>
        <!-- Hero Showcase -->
        <section class="relative pt-20 pb-16 overflow-hidden">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_30%,rgba(59,130,246,0.08),transparent_50%)]"></div>
            <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-xs font-semibold text-blue-400 mb-6">
                    <span class="flex h-2 w-2 rounded-full bg-blue-500 animate-pulse"></span>
                    Now Live: Active Ecosystem Monitored by SCITECH MGT
                </div>
                <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight mb-6 max-w-4xl mx-auto leading-[1.1]">
                    Turn Everyday Digital Tasks Into <span class="bg-gradient-to-r from-blue-400 via-indigo-400 to-purple-400 bg-clip-text text-transparent">Real Income</span>
                </h1>
                <p class="text-lg text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
                    Welcome to the premiere stateflix workspace layout. Stream media, learn specialized skills, engage with global tasks, and unlock immediate daily payouts.
                </p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                    <a href="#register" class="w-full sm:w-auto bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold px-8 py-4 rounded-xl shadow-xl shadow-blue-900/30 transition-all text-center">Create Your Free Account</a>
                    <a href="#earning-hub" class="w-full sm:w-auto bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold px-8 py-4 rounded-xl transition-all text-center">Explore Earning Portals</a>
                </div>
            </div>
        </section>

        <!-- Earning Grid Section -->
        <section id="earning-hub" class="py-16 bg-[#0b0f19] border-y border-slate-900">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">Multi-Tier Earning Channels</h2>
                    <p class="text-slate-400">Maximize your performance metrics by utilizing all interactive modules within the dashboard infrastructure.</p>
                </div>

                <!-- Category 1: Streaming Portals -->
                <div class="mb-12">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="p-2 rounded-lg bg-emerald-500/10 text-emerald-400"><i class="fa-solid fa-play"></i></div>
                        <h3 class="text-xl font-bold text-white">Streaming Portals</h3>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="bg-[#1e293b] border border-slate-800 rounded-2xl p-6 glow-hover flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between mb-4">
                                    <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-400 text-xl"><i class="fa-brands fa-spotify"></i></div>
                                    <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-bold uppercase tracking-wider">New</span>
                                </div>
                                <h4 class="text-lg font-bold text-white mb-2">Earn with Spotify</h4>
                                <p class="text-sm text-slate-400 leading-relaxed mb-6">Get compensated for streaming targeted audio tracks, evaluating music playlists, and leaving playlist feedback.</p>
                            </div>
                            <div class="border-t border-slate-800 pt-4 flex items-center justify-between"><span class="text-xs text-slate-500">High Conversion Rate</span><i class="fa-solid fa-arrow-right text-slate-400 text-sm"></i></div>
                        </div>
                        <div class="bg-[#1e293b] border border-slate-800 rounded-2xl p-6 glow-hover flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between mb-4">
                                    <div class="w-12 h-12 rounded-xl bg-red-500/10 flex items-center justify-center text-red-400 text-xl"><i class="fa-brands fa-youtube"></i></div>
                                </div>
                                <h4 class="text-lg font-bold text-white mb-2">YouTube Videos</h4>
                                <p class="text-sm text-slate-400 leading-relaxed mb-6">Watch assigned informational, promotional, or tutorial videos to automatically accumulate system reward credits.</p>
                            </div>
                            <div class="border-t border-slate-800 pt-4 flex items-center justify-between"><span class="text-xs text-slate-500">Instant Verification</span><i class="fa-solid fa-arrow-right text-slate-400 text-sm"></i></div>
                        </div>
                        <div class="bg-[#1e293b] border border-slate-800 rounded-2xl p-6 glow-hover flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between mb-4">
                                    <div class="w-12 h-12 rounded-xl bg-purple-500/10 flex items-center justify-center text-purple-400 text-xl"><i class="fa-brands fa-tiktok"></i></div>
                                </div>
                                <h4 class="text-lg font-bold text-white mb-2">TikTok Videos</h4>
                                <p class="text-sm text-slate-400 leading-relaxed mb-6">Review short-form promotional content directly within your personalized application dashboard queue.</p>
                            </div>
                            <div class="border-t border-slate-800 pt-4 flex items-center justify-between"><span class="text-xs text-slate-500">High Volume Queue</span><i class="fa-solid fa-arrow-right text-slate-400 text-sm"></i></div>
                        </div>
                    </div>
                </div>

                <!-- Category 2: Gamified Rewards -->
                <div class="mb-12">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="p-2 rounded-lg bg-amber-500/10 text-amber-400"><i class="fa-solid fa-gamepad"></i></div>
                        <h3 class="text-xl font-bold text-white">Gamified Rewards</h3>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="bg-[#1e293b] border border-slate-800 rounded-2xl p-6 glow-hover flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between mb-4">
                                    <div class="w-12 h-12 rounded-xl bg-orange-500/10 flex items-center justify-center text-orange-400 text-xl"><i class="fa-solid fa-palette"></i></div>
                                    <span class="px-2.5 py-0.5 rounded-full bg-orange-500/10 text-orange-400 text-xs font-bold uppercase tracking-wider">Hot</span>
                                </div>
                                <h4 class="text-lg font-bold text-white mb-2">Colour Challenge</h4>
                                <p class="text-sm text-slate-400 leading-relaxed mb-6">Engage in rapid color coordination modules to lock in system point allocations on successful completions.</p>
                            </div>
                            <div class="border-t border-slate-800 pt-4 flex items-center justify-between"><span class="text-xs text-slate-500">Fast-Paced Action</span><i class="fa-solid fa-arrow-right text-slate-400 text-sm"></i></div>
                        </div>
                        <div class="bg-[#1e293b] border border-slate-800 rounded-2xl p-6 glow-hover flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between mb-4">
                                    <div class="w-12 h-12 rounded-xl bg-indigo-500/10 flex items-center justify-center text-indigo-400 text-xl"><i class="fa-solid fa-lightbulb"></i></div>
                                </div>
                                <h4 class="text-lg font-bold text-white mb-2">Trivia Challenge</h4>
                                <p class="text-sm text-slate-400 leading-relaxed mb-6">Test your knowledge scope across diverse topics. Correct answers unlock operational profile milestones.</p>
                            </div>
                            <div class="border-t border-slate-800 pt-4 flex items-center justify-between"><span class="text-xs text-slate-500">Daily Refresh Slots</span><i class="fa-solid fa-arrow-right text-slate-400 text-sm"></i></div>
                        </div>
                        <div class="bg-[#1e293b] border border-slate-800 rounded-2xl p-6 glow-hover flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between mb-4">
                                    <div class="w-12 h-12 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-400 text-xl"><i class="fa-solid fa-calculator"></i></div>
                                </div>
                                <h4 class="text-lg font-bold text-white mb-2">Math for Fun</h4>
                                <p class="text-sm text-slate-400 leading-relaxed mb-6">Solve rapid arithmetic puzzles to increase daily workflow targets and demonstrate user task consistency.</p>
                            </div>
                            <div class="border-t border-slate-800 pt-4 flex items-center justify-between"><span class="text-xs text-slate-500">Brain Exercise Portals</span><i class="fa-solid fa-arrow-right text-slate-400 text-sm"></i></div>
                        </div>
                    </div>
                </div>

                <!-- Category 3: Premium Class Content -->
                <div class="mb-12">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="p-2 rounded-lg bg-blue-500/10 text-blue-400"><i class="fa-solid fa-graduation-cap"></i></div>
                        <h3 class="text-xl font-bold text-white">Premium Educational Hub</h3>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                        <div class="bg-[#1e293b] border border-slate-800 rounded-2xl p-6 glow-hover flex flex-col justify-between">
                            <div>
                                <div class="w-12 h-12 rounded-xl bg-cyan-500/10 flex items-center justify-center text-cyan-400 text-xl mb-4"><i class="fa-solid fa-chart-line"></i></div>
                                <h4 class="text-base font-bold text-white mb-2">Free Forex Classes</h4>
                                <p class="text-xs text-slate-400 leading-relaxed mb-4">Access comprehensive base metrics covering foreign currency pairs, analysis setups, and trade executions.</p>
                            </div>
                            <div class="border-t border-slate-800 pt-3 text-xs text-blue-400 font-semibold flex items-center justify-between">Start Learning <i class="fa-solid fa-chevron-right text-[10px]"></i></div>
                        </div>
                        <div class="bg-[#1e293b] border border-slate-800 rounded-2xl p-6 glow-hover flex flex-col justify-between">
                            <div>
                                <div class="w-12 h-12 rounded-xl bg-teal-500/10 flex items-center justify-center text-teal-400 text-xl mb-4"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
                                <h4 class="text-base font-bold text-white mb-2">Deriv Tips</h4>
                                <p class="text-xs text-slate-400 leading-relaxed mb-4">Acquire structural mechanics covering synthetic indices and specialized algorithmic risk mitigation patterns.</p>
                            </div>
                            <div class="border-t border-slate-800 pt-3 text-xs text-blue-400 font-semibold flex items-center justify-between">Unlock Guide <i class="fa-solid fa-chevron-right text-[10px]"></i></div>
                        </div>
                        <div class="bg-[#1e293b] border border-slate-800 rounded-2xl p-6 glow-hover flex flex-col justify-between">
                            <div>
                                <div class="w-12 h-12 rounded-xl bg-amber-500/10 flex items-center justify-center text-amber-400 text-xl mb-4"><i class="fa-solid fa-book-open"></i></div>
                                <h4 class="text-base font-bold text-white mb-2">Business Ebooks</h4>
                                <p class="text-xs text-slate-400 leading-relaxed mb-4">Download digital resources containing curated scaling methodologies, workflow design, and financial growth formulas.</p>
                            </div>
                            <div class="border-t border-slate-800 pt-3 text-xs text-blue-400 font-semibold flex items-center justify-between">Download Assets <i class="fa-solid fa-chevron-right text-[10px]"></i></div>
                        </div>
                        <div class="bg-[#1e293b] border border-slate-800 rounded-2xl p-6 glow-hover flex flex-col justify-between">
                            <div>
                                <div class="w-12 h-12 rounded-xl bg-purple-500/10 flex items-center justify-center text-purple-400 text-xl mb-4"><i class="fa-solid fa-laptop-code"></i></div>
                                <h4 class="text-base font-bold text-white mb-2">New Tech Classes</h4>
                                <p class="text-xs text-slate-400 leading-relaxed mb-4">Review fundamental programming stacks, automation framework protocols, and digital workspace tool deployment.</p>
                            </div>
                            <div class="border-t border-slate-800 pt-3 text-xs text-blue-400 font-semibold flex items-center justify-between">View Classes <i class="fa-solid fa-chevron-right text-[10px]"></i></div>
                        </div>
                    </div>
                </div>

                <!-- Category 4: Engagement & Microtasks -->
                <div>
                    <div class="flex items-center gap-3 mb-6">
                        <div class="p-2 rounded-lg bg-pink-500/10 text-pink-400"><i class="fa-solid fa-bolt"></i></div>
                        <h3 class="text-xl font-bold text-white">Engagement & Microtasks</h3>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="bg-[#1e293b] border border-slate-800 rounded-2xl p-6 glow-hover flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between mb-4">
                                    <div class="w-12 h-12 rounded-xl bg-pink-500/10 flex items-center justify-center text-pink-400 text-xl"><i class="fa-solid fa-mouse-pointer"></i></div>
                                </div>
                                <h4 class="text-lg font-bold text-white mb-2">Click Ads</h4>
                                <p class="text-sm text-slate-400 leading-relaxed mb-6">Visit vetted promotional marketing links, verify viewing timers, and effortlessly log validation sequences.</p>
                            </div>
                            <div class="border-t border-slate-800 pt-4 flex items-center justify-between"><span class="text-xs text-slate-500">Uncapped Daily Limits</span><i class="fa-solid fa-arrow-right text-slate-400 text-sm"></i></div>
                        </div>
                        <div class="bg-[#1e293b] border border-slate-800 rounded-2xl p-6 glow-hover flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between mb-4">
                                    <div class="w-12 h-12 rounded-xl bg-sky-500/10 flex items-center justify-center text-sky-400 text-xl"><i class="fa-solid fa-rotate"></i></div>
                                </div>
                                <h4 class="text-lg font-bold text-white mb-2">Multi-Tier Spins</h4>
                                <p class="text-sm text-slate-400 leading-relaxed mb-6">Access localized platform spin wheels to systematically trigger account bonuses and point allocations.</p>
                            </div>
                            <div class="border-t border-slate-800 pt-4 flex items-center justify-between"><span class="text-xs text-slate-500">Refreshes Hourly</span><i class="fa-solid fa-arrow-right text-slate-400 text-sm"></i></div>
                        </div>
                        <div class="bg-[#1e293b] border border-slate-800 rounded-2xl p-6 glow-hover flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between mb-4">
                                    <div class="w-12 h-12 rounded-xl bg-rose-500/10 flex items-center justify-center text-rose-400 text-xl"><i class="fa-solid fa-comments"></i></div>
                                    <span class="px-2.5 py-0.5 rounded-full bg-rose-500/10 text-rose-400 text-xs font-bold uppercase tracking-wider">New</span>
                                </div>
                                <h4 class="text-lg font-bold text-white mb-2">Chat Foreigners</h4>
                                <p class="text-sm text-slate-400 leading-relaxed mb-6">Engage in systemized language translation interactions and assist global communication channels.</p>
                            </div>
                            <div class="border-t border-slate-800 pt-4 flex items-center justify-between"><span class="text-xs text-slate-500">High Payout Base</span><i class="fa-solid fa-arrow-right text-slate-400 text-sm"></i></div>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- Onboarding Process Section -->
        <section id="how-it-works" class="py-20 bg-[#0f172a]">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-2xl mx-auto mb-16">
                    <h2 class="text-3xl font-extrabold text-white sm:text-4xl tracking-tight">Onboarding Architecture</h2>
                    <p class="mt-4 text-slate-400">Follow our stream-lined workflow mechanics to properly deploy your workspace presence.</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
                    <div class="bg-[#1e293b] p-8 rounded-2xl border border-slate-800 relative">
                        <div class="w-12 h-12 rounded-xl bg-blue-600 text-white flex items-center justify-center font-black text-xl mb-6 shadow-lg shadow-blue-600/20">1</div>
                        <h3 class="text-xl font-bold text-white mb-3">Create Profile</h3>
                        <p class="text-sm text-slate-400 leading-relaxed">Register your official user credentials securely to spin up your centralized analytics and earning dashboard setup.</p>
                    </div>
                    <div class="bg-[#1e293b] p-8 rounded-2xl border border-slate-800 relative">
                        <div class="w-12 h-12 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-black text-xl mb-6 shadow-lg shadow-indigo-600/20">2</div>
                        <h3 class="text-xl font-bold text-white mb-3">Complete Tasks</h3>
                        <p class="text-sm text-slate-400 leading-relaxed">Select specialized items within your dynamic queue—such as media streaming reviews or tech milestones.</p>
                    </div>
                    <div class="bg-[#1e293b] p-8 rounded-2xl border border-slate-800 relative">
                        <div class="w-12 h-12 rounded-xl bg-purple-600 text-white flex items-center justify-center font-black text-xl mb-6 shadow-lg shadow-purple-600/20">3</div>
                        <h3 class="text-xl font-bold text-white mb-3">Fast Payout</h3>
                        <p class="text-sm text-slate-400 leading-relaxed">Monitor verified data allocations and request instant balance processing directly into localized currency channels.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer Area -->
    <footer class="bg-[#0b0f19] border-t border-slate-900 py-12 text-slate-500 text-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="flex items-center gap-2">
                <div class="w-6 h-6 rounded-md bg-blue-600 flex items-center justify-center text-white text-xs font-black">S</div>
                <span class="font-bold text-slate-400 tracking-tight">STATEFLIX AGENCY</span>
            </div>
            <p>&copy; 2026 Stateflix Agency. All rights reserved. Managed by SCITECH MGT.</p>
            <div class="flex items-center gap-6">
                <a href="#terms" class="hover:text-slate-400 transition-colors">Terms of Service</a>
                <a href="#privacy" class="hover:text-slate-400 transition-colors">Privacy Protocol</a>
            </div>
        </div>
    </footer>

</body>
</html>
